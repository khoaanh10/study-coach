# Copy file này thành .env rồi điền key của bạn. KHÔNG commit file .env.
OPENAI_API_KEY=
# Cổng API của khóa học (AI Portal). Để trống nếu dùng OpenAI trực tiếp.
OPENAI_BASE_URL=https://aiportalapi.stu-platform.live/jpe
# Model mặc định (rẻ). Tên model đúng như trên AI Portal.
OPENAI_MODEL=GPT-4o-mini
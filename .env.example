# Copy file này thành .env rồi điền key của bạn. KHÔNG commit file .env.
OPENAI_API_KEY=

# Cổng API của khóa học (AI Portal). Để trống nếu dùng OpenAI trực tiếp.
OPENAI_BASE_URL=https://aiportalapi.stu-platform.live/jpe

# Model mặc định và model embedding trên AI Portal (phân biệt chữ hoa/thường).
OPENAI_MODEL=GPT-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cơ sở dữ liệu SQLite cục bộ & giới hạn chi phí tối đa mỗi phiên (USD).
DB_PATH=data/study_coach.db
MAX_SESSION_COST_USD=1.0

# Khóa bí mật ký cookie phiên đăng nhập. Nên đặt một chuỗi ngẫu nhiên dài khi triển khai, ví dụ:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Để trống thì app tự sinh một khóa ngẫu nhiên và lưu vào data/.session_secret (không commit).
SESSION_SECRET=
